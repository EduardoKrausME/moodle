    @template mod_book/courseindex_chapters

    The chapter tree inserted under the Book activity in the course index.
    Chapter titles and URLs are escaped by Mustache.
}}
<button type="button"
    class="book-courseindex-toggle"
    aria-controls="book-courseindex-tree-{{cmid}}"
    aria-expanded="true"
    aria-label="{{collapselabel}}">
    <span class="book-courseindex-chevron" aria-hidden="true"></span>
</button>
<nav id="book-courseindex-tree-{{cmid}}"
    class="book-courseindex-tree"
    aria-label="{{toclabel}}">
    <ul class="book-courseindex-list">
        {{#chapters}}
            <li class="book-courseindex-chapter {{#hidden}}dimmed{{/hidden}}">
                <a class="book-courseindex-link"
                    href="{{url}}"
                    {{#current}}aria-current="page"{{/current}}>{{title}}</a>
                {{#hassubchapters}}
                    <ul class="book-courseindex-subchapters">
                        {{#subchapters}}
                            <li class="book-courseindex-chapter {{#hidden}}dimmed{{/hidden}}">
                                <a class="book-courseindex-link"
                                    href="{{url}}"
                                    {{#current}}aria-current="page"{{/current}}>{{title}}</a>
                            </li>
                        {{/subchapters}}
                    </ul>
                {{/hassubchapters}}
            </li>
        {{/chapters}}
    </ul>
</nav>
