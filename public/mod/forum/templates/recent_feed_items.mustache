{{!
    @template mod_forum/recent_feed_items
    All user-generated text is escaped by Mustache.
}}
{{#items}}
    <article class="forum-recent-feed__item border rounded-3 p-3 mb-3" role="listitem" data-post-id="{{postid}}">
        <div class="forum-recent-feed__item-heading d-flex align-items-start justify-content-between gap-2">
            <h3 class="forum-recent-feed__item-title h5 mb-1">
                <a href="{{url}}" class="forum-recent-feed__item-link fw-semibold">{{subject}}</a>
            </h3>
            {{#unread}}
                <span class="forum-recent-feed__unread badge bg-primary flex-shrink-0">
                    {{#str}}recentfeedpostunread, mod_forum{{/str}}
                </span>
            {{/unread}}
        </div>
        {{#canfavourite}}
            <button type="button" class="btn btn-outline-secondary forum-recent-feed__favourite mb-2"
                    data-action="feed-favourite" data-discussion-id="{{discussionid}}"
                    data-favourited="{{#favourited}}1{{/favourited}}{{^favourited}}0{{/favourited}}"
                    aria-pressed="{{#favourited}}true{{/favourited}}{{^favourited}}false{{/favourited}}"
                    aria-label="{{#favourited}}{{#str}}recentfeedunfollow, mod_forum{{/str}}{{/favourited}}{{^favourited}}{{#str}}recentfeedfollow, mod_forum{{/str}}{{/favourited}}">
                <span data-region="favourite-symbol" aria-hidden="true">{{#favourited}}★{{/favourited}}{{^favourited}}☆{{/favourited}}</span>
                <span data-region="favourite-label">{{#favourited}}{{#str}}recentfeedunfollow, mod_forum{{/str}}{{/favourited}}{{^favourited}}{{#str}}recentfeedfollow, mod_forum{{/str}}{{/favourited}}</span>
            </button>
        {{/canfavourite}}
        <div class="forum-recent-feed__meta small text-muted mb-2">
            <span>{{coursename}}</span>
            <span>{{forumname}}</span>
            <span>{{author}}</span>
            <span>{{time}}</span>
        </div>
        {{#preview}}<p class="forum-recent-feed__preview mb-2">{{preview}}</p>{{/preview}}
        {{#solved}}
            <p class="mb-2"><span class="badge bg-success">{{#str}}acceptedsolution, mod_forum{{/str}}</span>
            <a href="{{solutionurl}}" class="ms-2">{{#str}}viewsolution, mod_forum{{/str}}</a></p>
        {{/solved}}
        {{#canmarksolution}}
            <button class="btn btn-sm btn-outline-primary mb-2" type="button" data-action="solution-set"
                    data-discussion-id="{{discussionid}}"
                    data-target-post-id="{{#iscurrentaccepted}}0{{/iscurrentaccepted}}{{^iscurrentaccepted}}{{postid}}{{/iscurrentaccepted}}"
                    aria-pressed="{{#iscurrentaccepted}}true{{/iscurrentaccepted}}{{^iscurrentaccepted}}false{{/iscurrentaccepted}}">
                {{#iscurrentaccepted}}{{#str}}removesolution, mod_forum{{/str}}{{/iscurrentaccepted}}
                {{^iscurrentaccepted}}{{#solved}}{{#str}}replacesolution, mod_forum{{/str}}{{/solved}}{{^solved}}{{#str}}marksolution, mod_forum{{/str}}{{/solved}}{{/iscurrentaccepted}}
            </button>
        {{/canmarksolution}}
        {{#canreply}}
            <div class="forum-recent-feed__reply-actions d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-primary" data-action="feed-reply-open"
                        aria-controls="forum-feed-reply-{{postid}}" aria-expanded="false">
                    {{#str}}recentfeedreply, mod_forum{{/str}}
                </button>
                <button type="button" class="btn btn-outline-secondary" data-action="feed-quote-open"
                        aria-controls="forum-feed-reply-{{postid}}" aria-expanded="false">
                    {{#str}}recentfeedquote, mod_forum{{/str}}
                </button>
                <button type="button" class="btn btn-outline-secondary" data-action="feed-mention-open"
                        aria-controls="forum-feed-reply-{{postid}}" aria-expanded="false">
                    {{#str}}recentfeedmention, mod_forum{{/str}}
                </button>
            </div>
            <div class="forum-recent-feed__reply-panel mt-3" data-region="feed-reply-panel"
                 id="forum-feed-reply-{{postid}}" hidden>
                <div class="forum-recent-feed__reply-quote border-start ps-3 mb-2"
                     data-region="feed-reply-quote" hidden></div>
                <form data-action="feed-reply-form" data-post-id="{{postid}}">
                    <label class="form-label" for="forum-feed-message-{{postid}}">
                        {{#str}}recentfeedreply, mod_forum{{/str}}
                    </label>
                    <textarea class="form-control mb-2" data-region="feed-reply-message"
                              id="forum-feed-message-{{postid}}" rows="4" maxlength="12000"
                              placeholder="{{#str}}recentfeedreplyplaceholder, mod_forum{{/str}}"
                              required></textarea>
                    <div data-region="feed-mention-suggestions" class="forum-recent-feed__mentions"
                         aria-live="polite" hidden></div>
                    <p class="small text-muted" data-region="feed-reply-feedback" role="status"
                       aria-live="polite"></p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary" data-action="feed-reply-send">
                            {{#str}}recentfeedreplysend, mod_forum{{/str}}
                        </button>
                        <button type="button" class="btn btn-outline-secondary"
                                data-action="feed-reply-cancel">
                            {{#str}}recentfeedreplycancel, mod_forum{{/str}}
                        </button>
                        <a class="btn btn-link" href="{{advancedurl}}">
                            {{#str}}recentfeedreplyadvanced, mod_forum{{/str}}
                        </a>
                    </div>
                </form>
            </div>
        {{/canreply}}
    </article>
{{/items}}
