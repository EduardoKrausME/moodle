    @template mod_book/reading_progress
    Per-user chapter visitation summary; does not change Moodle completion.
}}
<div class="book-reading-progress" aria-label="{{label}}">
    <div class="book-reading-progress__heading">
        <strong>{{label}}</strong>
        <span>{{visitedcount}}/{{totalcount}} - {{percent}}%</span>
    </div>
    <progress class="book-reading-progress__bar" max="100" value="{{percent}}"
        aria-label="{{label}}">{{percent}}%</progress>
    {{#resume}}
        <a class="book-reading-progress__resume btn btn-outline-primary"
            href="{{url}}">{{label}}: {{title}}</a>
    {{/resume}}
</div>
