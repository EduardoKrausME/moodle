{{!
    @template mod_quiz/quiz_overview

    Overview for the quiz entry page. Facts and status are escaped by Mustache.
    Actions are rendered by the existing, permission-aware quiz renderer.

    Example context (json):
    {
        "status": "Ready to start",
        "facts": [{"label": "Attempts allowed", "value": "2"}],
        "hasactions": false,
        "actions": ""
    }
}}
<section class="mod-quiz-overview" aria-labelledby="mod-quiz-overview-heading">
    <div class="mod-quiz-overview__header">
        <div class="mod-quiz-overview__introduction">
            <h2 class="h4 mb-2" id="mod-quiz-overview-heading">{{#str}} quizoverviewtitle, quiz {{/str}}</h2>
            <p class="mod-quiz-overview__status mb-0">{{status}}</p>
        </div>
        {{#hasactions}}
            <div class="mod-quiz-overview__actions">
                {{{actions}}}
            </div>
        {{/hasactions}}
    </div>
    <dl class="mod-quiz-overview__facts mb-0">
        {{#facts}}
            <div class="mod-quiz-overview__fact">
                <dt>{{label}}</dt>
                <dd>{{value}}</dd>
            </div>
        {{/facts}}
    </dl>
</section>
