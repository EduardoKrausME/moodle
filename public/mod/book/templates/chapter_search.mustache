    @template mod_book/chapter_search
    Server-side search across the currently accessible Book chapters.
}}
<section class="book-search" aria-label="{{#str}}searchinbook, mod_book{{/str}}">
    <form action="{{searchurl}}" method="get" class="book-search__form" role="search">
        <input type="hidden" name="id" value="{{cmid}}">
        <label for="book-search-input">{{#str}}searchinbook, mod_book{{/str}}</label>
        <div class="book-search__field">
            <input type="search" id="book-search-input" name="q" value="{{query}}"
                maxlength="100" class="form-control" autocomplete="off"
                placeholder="{{#str}}searchchapterplaceholder, mod_book{{/str}}">
            <button type="submit" class="btn btn-outline-primary">{{#str}}search, core{{/str}}</button>
        </div>
    </form>
    {{#searched}}
        <div class="book-search__results" aria-live="polite">
            <p><strong>{{#str}}booksearchresults, mod_book{{/str}}</strong> ({{count}})</p>
            {{#results}}
                <article class="book-search__result">
                    <a href="{{url}}">{{title}}</a>
                    {{#excerpt}}<p>{{excerpt}}</p>{{/excerpt}}
                </article>
            {{/results}}
            {{^results}}
                <p>{{#str}}booksearchnomatches, mod_book{{/str}}</p>
            {{/results}}
        </div>
    {{/searched}}
</section>
