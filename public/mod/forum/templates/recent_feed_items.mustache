{{!
    @template mod_forum/recent_feed_items
    All user-generated text is escaped by Mustache.
}}
{{#items}}
    <article class="forum-recent-feed__item border rounded-3 p-3 mb-3" role="listitem" data-post-id="{{postid}}">
        <div class="forum-recent-feed__item-heading d-flex align-items-start justify-content-between gap-2">
            <h3 class="forum-recent-feed__item-title h5 mb-1">
                <a href="{{url}}" class="forum-recent-feed__item-link fw-semibold">{{subject}}</a>
            </h3>
            {{#unread}}
                <span class="forum-recent-feed__unread badge bg-primary flex-shrink-0">
                    {{#str}}recentfeedpostunread, mod_forum{{/str}}
                </span>
            {{/unread}}
        </div>
        <div class="forum-recent-feed__meta small text-muted mb-2">
            <span>{{coursename}}</span>
            <span>{{forumname}}</span>
            <span>{{author}}</span>
            <span>{{time}}</span>
        </div>
        {{#preview}}<p class="forum-recent-feed__preview mb-0">{{preview}}</p>{{/preview}}
    </article>
{{/items}}
