    @template mod_book/main_action_menu

    The previous/next navigation displayed after the current Book chapter.
}}
<nav class="book-chapter-footer" aria-label="{{#str}}modulename, book{{/str}}">
    <p class="book-chapter-footer__position">{{position}}</p>
    <div class="book-chapter-footer__controls">
        {{#previous}}
            <a class="book-chapter-footer__link book-chapter-footer__link--previous"
                href="{{url}}#mod_book-chapter"
                aria-label="{{title}}">
                <span class="book-chapter-footer__icon" aria-hidden="true">
                    {{#pix}} i/previous, core {{/pix}}
                </span>
                <span class="book-chapter-footer__text">
                    <span class="book-chapter-footer__label">{{#str}}navprev, book{{/str}}</span>
                    <span class="book-chapter-footer__title">{{chaptertitle}}</span>
                </span>
            </a>
        {{/previous}}
        {{#next}}
            <a class="book-chapter-footer__link book-chapter-footer__link--next"
                href="{{url}}#mod_book-chapter"
                aria-label="{{title}}">
                <span class="book-chapter-footer__text">
                    <span class="book-chapter-footer__label">{{#str}}navnext, book{{/str}}</span>
                    <span class="book-chapter-footer__title">{{chaptertitle}}</span>
                </span>
                <span class="book-chapter-footer__icon" aria-hidden="true">
                    {{#pix}} i/next, core {{/pix}}
                </span>
            </a>
        {{/next}}
    </div>
</nav>
