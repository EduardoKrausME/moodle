{{!
    @template mod_quiz/list_of_attempts

    This template renders summary information about a list of quiz attempts.

    The structure for each attempt should be what is required by mod_quiz/attempt_summary_information.

    Example context (json):
    {
        "hasattempts": true,
        "attempts": [
            {
                "name": "Attempt 1",
                "statuslabel": "Finished",
                "statusvariant": "finished",
                "islatest": false,
                "headingid": "mod-quiz-history-attempt-13",
                "hasreviewlink": true,
                "reviewlink": "<a href='https://qa.moodledemo.net/mod/quiz/review.php?attempt=13&cmid=30'>Review</a>",
                "summarydata": {
                    "hasitems": true,
                    "items": [
                        {
                            "title": "<img src='https://qa.moodledemo.net/pluginfile.php/27/user/icon/boost/f2?rev=5522' class='userpicture' width='35' height='35' alt='It is me!'>",
                            "content": "<a href='https://qa.moodledemo.net/user/view.php?id=4&amp;course=2'>Sam Student</a>"
                        },
                        {"title": "Status", "content": "Finished"},
                        {"title": "Started", "content": "Thursday, 23 November 2023, 9:29 AM"},
                        {"title": "Completed", "content": "Thursday, 23 November 2023, 9:32 AM"},
                        {"title": "Duration", "content": "3 minutes"},
                        {"title": "Grade", "content": "Not yet graded"}
                    ]
                }
            }
        ]
    }
}}
{{#hasattempts}}
<h3 id="mod-quiz-attempt-history-heading">{{#str}} summaryofattempts, quiz {{/str}}</h3>
<ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3 mod-quiz-attempt-history"
        aria-labelledby="mod-quiz-attempt-history-heading">
    {{#attempts}}
        <li class="col mod-quiz-attempt-history__item">
            <article class="card h-100 mod-quiz-attempt-history__card
                    mod-quiz-attempt-history__card--{{statusvariant}}" aria-labelledby="{{headingid}}">
                <header class="card-header mod-quiz-attempt-history__header">
                    <div class="mod-quiz-attempt-history__heading">
                        <h4 id="{{headingid}}" class="card-title my-0">{{name}}</h4>
                        {{#islatest}}
                            <span class="mod-quiz-attempt-history__latest">
                                {{#str}} historylatestattempt, quiz {{/str}}
                            </span>
                        {{/islatest}}
                    </div>
                    <span class="mod-quiz-attempt-history__status
                            mod-quiz-attempt-history__status--{{statusvariant}}">
                        {{statuslabel}}
                    </span>
                </header>
                <div class="mod-quiz-attempt-history__details">
                    {{#summarydata}}
                        {{> mod_quiz/attempt_summary_information}}
                    {{/summarydata}}
                </div>
                {{#hasreviewlink}}
                    <footer class="card-footer mod-quiz-attempt-history__actions">
                        {{{reviewlink}}}
                    </footer>
                {{/hasreviewlink}}
            </article>
        </li>
    {{/attempts}}
</ul>
{{/hasattempts}}
