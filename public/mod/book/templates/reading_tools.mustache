    @template mod_book/reading_tools
    The current reader's own favourite, private note and export links.
}}
<section class="book-personal-tools" aria-label="{{#str}}personalreadingtools, mod_book{{/str}}">
    <div class="book-personal-tools__top">
        <form action="{{posturl}}" method="post">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="chapterid" value="{{chapterid}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="favourite">
            {{#favourite}}
                <input type="hidden" name="favourite" value="0">
                <button type="submit" class="btn btn-outline-primary">{{#str}}removebookmark, mod_book{{/str}}</button>
            {{/favourite}}
            {{^favourite}}
                <input type="hidden" name="favourite" value="1">
                <button type="submit" class="btn btn-outline-primary">{{#str}}bookmarkchapter, mod_book{{/str}}</button>
            {{/favourite}}
        </form>
        <a class="btn btn-link" href="{{exporturl}}">{{#str}}exportpersonalnotes, mod_book{{/str}}</a>
        {{#printurl}}<a class="btn btn-link" href="{{printurl}}">{{#str}}printwholebook, mod_book{{/str}}</a>{{/printurl}}
    </div>
    <details class="book-personal-tools__details">
        <summary>{{#str}}mynotes, mod_book{{/str}}</summary>
        <p class="book-personal-tools__hint">{{#str}}notesprivatehelp, mod_book{{/str}}</p>
        <form method="post" action="{{posturl}}">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="chapterid" value="{{chapterid}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="note">
            <label for="book-personal-note">{{#str}}chapterannotation, mod_book{{/str}}</label>
            <textarea id="book-personal-note" name="note" class="form-control"
                maxlength="5000" rows="5">{{note}}</textarea>
            <button type="submit" class="btn btn-primary mt-2">{{#str}}savenote, mod_book{{/str}}</button>
        </form>
    </details>
    {{#hasfavourites}}
        <details class="book-personal-tools__details">
            <summary>{{#str}}mybookmarks, mod_book{{/str}} ({{favouritecount}})</summary>
            <ul>
                {{#favourites}}
                    <li><a href="{{url}}">{{title}}</a></li>
                {{/favourites}}
            </ul>
        </details>
    {{/favourites}}
</section>
