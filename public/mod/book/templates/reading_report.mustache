    @template mod_book/reading_report
    Participant chapter-visit statistics visible to authorized teachers.
}}
<section class="book-reading-report">
    <p>{{#str}}metricsdisclaimer, mod_book{{/str}}</p>
    <div class="book-reading-report__actions">
        <a class="btn btn-outline-primary" href="{{csvurl}}">{{#str}}exportreportcsv, mod_book{{/str}}</a>
        <a class="btn btn-link" href="{{returnurl}}">{{#str}}returntobook, mod_book{{/str}}</a>
    </div>
    <div class="table-responsive">
        <table class="table table-striped">
            <caption>{{#str}}readingsummary, mod_book{{/str}} ({{totalusers}})</caption>
            <thead><tr>
                <th scope="col">{{#str}}participantname, mod_book{{/str}}</th>
                <th scope="col">{{#str}}chaptersvisited, mod_book{{/str}}</th>
                <th scope="col">{{#str}}readingpercent, mod_book{{/str}}</th>
                <th scope="col">{{#str}}lastreadchapter, mod_book{{/str}}</th>
                <th scope="col">{{#str}}lastaccessed, mod_book{{/str}}</th>
            </tr></thead>
            <tbody>
                {{#users}}
                    <tr><th scope="row">{{name}}</th>
                        <td>{{visited}}/{{total}}</td>
                        <td>{{percent}}%</td>
                        <td>{{lastchapter}}</td>
                        <td>{{lastviewed}}</td>
                    </tr>
                {{/users}}
                {{^users}}
                    <tr><td colspan="5">{{#str}}noreadingdata, mod_book{{/str}}</td></tr>
                {{/users}}
            </tbody>
        </table>
    </div>
    <nav class="book-reading-report__pages">
        {{#previousurl}}<a class="btn btn-outline-secondary" href="{{previousurl}}">{{#str}}bookreportprevious, mod_book{{/str}}</a>{{/previousurl}}
        {{#nexturl}}<a class="btn btn-outline-secondary" href="{{nexturl}}">{{#str}}bookreportnext, mod_book{{/str}}</a>{{/nexturl}}
    </nav>
</section>
