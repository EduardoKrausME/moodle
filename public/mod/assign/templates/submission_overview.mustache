{{!
    @template mod_assign/submission_overview

    Student-facing status, deadline and visible grade summary on the assignment landing page.
    Native submission controls, feedback and plugin output are rendered separately.

    Example context (json):
    {
        "submissionstatus": "Submitted for grading",
        "gradingstatus": "Not graded",
        "duedate": "Friday, 20 November 2026, 11:59 PM",
        "grade": "",
        "hasgrade": false,
        "locked": false,
        "submitted": true
    }
}}
<section class="assign-landing-overview" aria-labelledby="assign-landing-overview-heading">
    <h2 id="assign-landing-overview-heading" class="h4 mb-3">{{#str}}submissionstatusheading, mod_assign{{/str}}</h2>
    <div class="assign-landing-overview-grid">
        <dl class="assign-landing-overview-item mb-0">
            <dt>{{#str}}submissionstatus, mod_assign{{/str}}</dt>
            <dd{{#submitted}} class="assign-landing-submitted"{{/submitted}}>{{submissionstatus}}</dd>
        </dl>
        {{#duedate}}
            <dl class="assign-landing-overview-item mb-0">
                <dt>{{#str}}duedate, mod_assign{{/str}}</dt>
                <dd>{{duedate}}</dd>
            </dl>
        {{/duedate}}
        <dl class="assign-landing-overview-item mb-0">
            <dt>{{#str}}gradingstatus, mod_assign{{/str}}</dt>
            <dd>{{gradingstatus}}</dd>
        </dl>
        {{#hasgrade}}
            <dl class="assign-landing-overview-item mb-0 assign-landing-overview-grade">
                <dt>{{#str}}gradenoun{{/str}}</dt>
                <dd>{{grade}}</dd>
            </dl>
        {{/hasgrade}}
    </div>
    {{#groupoverview}}
        <section class="assign-group-overview assign-group-overview--{{state}} mt-3"
                 data-region="assign-group-overview" aria-labelledby="assign-group-overview-heading">
            <h3 id="assign-group-overview-heading" class="h5 mb-3">{{heading}}</h3>
            {{#showgroupname}}
                <dl class="assign-group-overview-summary mb-3">
                    <div>
                        <dt>{{namelabel}}</dt>
                        <dd class="mb-0">{{{groupname}}}</dd>
                    </div>
                    <div>
                        <dt>{{statuslabel}}</dt>
                        <dd class="mb-0">{{nativestatus}}</dd>
                    </div>
                </dl>
            {{/showgroupname}}
            <p class="assign-group-overview-state mb-1"><strong>{{statelabel}}</strong></p>
            <p class="mb-0">{{description}}</p>
            {{#showprogress}}
                <div class="assign-group-overview-progress mt-3" data-region="assign-group-confirmations">
                    <p class="mb-2"><strong>{{countlabel}}</strong></p>
                    <progress class="assign-group-overview-meter" value="{{confirmed}}" max="{{total}}"
                              aria-label="{{progresslabel}}">{{countlabel}}</progress>
                    {{#haspending}}
                        <p class="mb-1">{{pendinglabel}}</p>
                    {{/haspending}}
                    {{#myconfirmed}}
                        <p class="assign-group-overview-personal mb-0">{{myconfirmednote}}</p>
                    {{/myconfirmed}}
                    {{^myconfirmed}}
                        <p class="assign-group-overview-personal mb-0">{{mypendingnote}}</p>
                    {{/myconfirmed}}
                </div>
            {{/showprogress}}
            {{#onecanfinish}}
                <p class="assign-group-overview-note mt-2 mb-0">{{singleconfirmationnote}}</p>
            {{/onecanfinish}}
            {{#noeligiblemembers}}
                <p class="assign-group-overview-note mt-2 mb-0">{{nomembersnote}}</p>
            {{/noeligiblemembers}}
        </section>
    {{/groupoverview}}
    {{#workflow}}
        <section class="assign-submission-workflow assign-submission-workflow--{{state}} mt-3"
                 aria-labelledby="assign-submission-workflow-heading">
            <h3 id="assign-submission-workflow-heading" class="h5 mb-2">{{heading}}</h3>
            <p class="assign-submission-workflow-status mb-1"><strong>{{label}}</strong></p>
            <p class="mb-0">{{description}}</p>
            {{#requiresconfirmation}}
                <ol class="assign-submission-workflow-steps mt-3 mb-0">
                    <li class="assign-submission-workflow-step{{#preparationcomplete}} is-complete{{/preparationcomplete}}">
                        <span class="assign-submission-workflow-number" aria-hidden="true">1</span>
                        {{step1}}
                    </li>
                    <li class="assign-submission-workflow-step{{#finalcomplete}} is-complete{{/finalcomplete}}">
                        <span class="assign-submission-workflow-number" aria-hidden="true">2</span>
                        {{step2}}
                    </li>
                </ol>
            {{/requiresconfirmation}}
            {{#groupnote}}
                <p class="assign-submission-workflow-groupnote mt-2 mb-0">{{groupnote}}</p>
            {{/groupnote}}
        </section>
    {{/workflow}}
    {{#availability}}
        <section class="assign-availability mt-3" aria-labelledby="assign-availability-title">
            <div class="assign-availability-heading">
                <h3 id="assign-availability-title" class="h5 mb-0">{{#str}}availabilityheading, mod_assign{{/str}}</h3>
                <span class="assign-availability-state assign-availability-state--{{state}}">{{label}}</span>
            </div>
            {{#hasdates}}
                <ol class="assign-availability-timeline">
                    {{#dates}}
                        <li class="assign-availability-event{{#extension}} assign-availability-event--extension{{/extension}}">
                            <span class="assign-availability-event-label">{{label}}</span>
                            <time datetime="{{datetime}}">{{value}}</time>
                        </li>
                    {{/dates}}
                </ol>
            {{/hasdates}}
            {{#timeleft}}
                <p class="assign-availability-timeleft">
                    {{#str}}availabilitytimeremaining, mod_assign{{/str}}: <strong>{{timeleft}}</strong>
                </p>
            {{/timeleft}}
            {{#latenotice}}
                <p class="assign-availability-notice">{{latenotice}}</p>
            {{/latenotice}}
            {{#timelimit}}
                <div class="assign-availability-limit">
                    <strong>{{#str}}timelimit, mod_assign{{/str}}: {{timelimit}}</strong>
                    <p class="mb-0">{{timerhint}}</p>
                </div>
            {{/timelimit}}
        </section>
    {{/availability}}
    {{#locked}}
        <p class="alert alert-warning mt-3 mb-0">{{#str}}submissionslocked, mod_assign{{/str}}</p>
    {{/locked}}
</section>
